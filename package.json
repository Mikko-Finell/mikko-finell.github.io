{
  "name": "mikko-finell.github.io",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "packageManager": "npm@12.0.1",
  "engines": {
    "node": "26.5.0",
    "npm": "12.0.1"
  },
  "scripts": {
    "dev": "vite",
    "preview": "vite preview",
    "format": "biome format --write .",
    "format:check": "biome format .",
    "lint": "biome lint --error-on-warnings .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --passWithNoTests",
    "test:browser": "playwright test",
    "build": "vite build && node scripts/static-render.mjs && node scripts/generate-pdf.mjs",
    "check:content": "node scripts/check-content-assets.mjs",
    "check:metadata-output": "node scripts/check-metadata-output.mjs",
    "check:pdf-output": "node scripts/check-pdf-output.mjs",
    "check:production-output": "node scripts/check-production-output.mjs",
    "check:static-output": "node scripts/check-static-output.mjs",
    "check:ui": "node scripts/check-ui-boundaries.mjs",
    "check": "npm run check:ui && npm run check:content && npm run format:check && npm run lint && npm run typecheck && npm run test && npm run build && npm run check:static-output && npm run check:metadata-output && npm run check:production-output && npm run check:pdf-output && npm run test:browser"
  },
  "dependencies": {
    "react": "19.2.7",
    "react-dom": "19.2.7"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.12.1",
    "@biomejs/biome": "2.5.4",
    "@mdx-js/mdx": "3.1.1",
    "@mdx-js/rollup": "3.1.1",
    "@playwright/test": "1.61.1",
    "@types/mdx": "2.0.14",
    "@types/react": "19.2.17",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.3",
    "estree-util-value-to-estree": "3.5.0",
    "hast-util-to-text": "4.0.2",
    "rehype-slug": "6.0.0",
    "remark-gfm": "4.0.1",
    "typescript": "7.0.2",
    "unified": "11.0.5",
    "unist-util-visit": "5.1.0",
    "vite": "8.1.4",
    "vitest": "4.1.10"
  }
}
